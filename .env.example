# Copy to .env.local (web) or export in the shell. Never commit real values.
APP_ENV=development
APP_URL=http://localhost:3000
# Privileged connection: migrations and db:setup only.
DATABASE_URL=
# RLS-bound connection used by the web server (role lex_app).
APP_DATABASE_URL=
# Worker connection (role lex_worker, BYPASSRLS; authorisation re-checked in code).
WORKER_DATABASE_URL=
# Model provider: none | openai | anthropic. "none" means no live model; UI labels this.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
DEMO_MODE=false
UPLOAD_MAX_MB=10
DOCUMENT_MAX_PAGES=50
JOB_MAX_ATTEMPTS=3
GENERATION_TIMEOUT_SECONDS=90
SESSION_TTL_HOURS=336
# Local Postgres bootstrap used by `pnpm db:setup` (defaults shown).
# PG_ADMIN_URL=postgres://postgres@localhost:5432/postgres
# PG_DB_NAME=lex_dev
